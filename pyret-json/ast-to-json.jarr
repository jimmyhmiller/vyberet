        if (val.$constrFor !== undefined) {
          thisRuntime.ffi.throwLookupConstructorNotObject(makeSrcloc(loc), val.$constrFor, field);
        }
        thisRuntime.ffi.throwLookupNonObject(makeSrcloc(loc), val, field);
